# GitHub token for the contribution graph on the home page.
# Server-side only: fetched in src/app/api/github/route.ts, never exposed to the browser.
# Create one at https://github.com/settings/tokens
#   classic token: no scopes needed · fine-grained: read-only access to public data
# Then restart the dev server. Without it the panel shows a graceful fallback.
GITHUB_TOKEN=
